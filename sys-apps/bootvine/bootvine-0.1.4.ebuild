RUST_MIN_VER="1.91.0"

inherit cargo systemd

DESCRIPTION="Live tree of systemd/OpenRC jobs on the console during boot and shutdown"
HOMEPAGE="https://codeberg.org/wvhulle/bootvine"
SRC_URI="
	https://codeberg.org/wvhulle/bootvine/archive/v${PV}.tar.gz -> ${P}.tar.gz
	${CARGO_CRATE_URIS}
"
S="${WORKDIR}/${PN}"

LICENSE="GPL-3+"
# Dependent crate licenses
LICENSE+="
	Apache-2.0 ISC LGPL-2.1+ MIT Unicode-3.0 Unicode-DFS-2016 Unlicense
	WTFPL-2 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
IUSE="openrc +systemd"
REQUIRED_USE="|| ( openrc systemd )"

DEPEND="
	systemd? (
		sys-apps/dbus
		sys-apps/systemd:=
	)
"
RDEPEND="
	${DEPEND}
	openrc? ( sys-apps/openrc )
"
BDEPEND="systemd? ( virtual/pkgconfig )"

QA_FLAGS_IGNORED="usr/bin/${PN}"

src_configure() {
	local myfeatures=(
		$(usev openrc)
		$(usev systemd)
	)
	cargo_src_configure --no-default-features
}

src_compile() {
	cargo_src_compile --package ${PN}
}

src_test() {
	cargo_src_test --package ${PN} --package ${PN}-screen \
		$(usev openrc "--package ${PN}-openrc-link") \
		$(usev systemd "--package ${PN}-systemd-link")
}

src_install() {
	dobin "$(cargo_target_dir)/${PN}"

	local files="${PN}/system-files"
	if use systemd; then
		systemd_dounit "${files}"/systemd/${PN}{,-shutdown}.service
		# Keep the upstream file name: the dracut module copies it by path.
		insinto "$(systemd_get_systemunitdir)/systemd-hibernate-resume.service.d"
		doins "${files}/systemd/systemd-hibernate-resume.service.d/${PN}.conf"

		exeinto /usr/lib/dracut/modules.d/90${PN}
		doexe "${files}/dracut/90${PN}/module-setup.sh"
	fi

	if use openrc; then
		newinitd "${files}/openrc/${PN}" ${PN}
	fi

	dodoc README.md CHANGELOG.md docs/{guide,configuration,architecture}.md
}

pkg_postinst() {
	if use systemd; then
		elog "To show stage 2 and shutdown under systemd, enable the units:"
		elog "  systemctl enable ${PN}.service ${PN}-shutdown.service"
		elog
		elog "To show the boot from a systemd-based dracut initramfs as well, add"
		elog "  add_dracutmodules+=\" ${PN} \""
		elog "to a file in /etc/dracut.conf.d/ and regenerate the initramfs."
	fi
	if use openrc; then
		elog "To show the boot under OpenRC, add the service to the sysinit runlevel:"
		elog "  rc-update add ${PN} sysinit"
	fi
	elog
	elog "Configuration is read from /etc/${PN}.toml; see"
	elog "/usr/share/doc/${PF}/configuration.md"
}
